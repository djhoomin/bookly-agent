# Copy to .env and fill in. providers.py loads it at import; .env is gitignored.

# Direct Anthropic API (the default provider).
ANTHROPIC_API_KEY=

# OpenRouter, used when BOOKLY_PROVIDER is openrouter or openrouter-eu.
OPENROUTER_API_KEY=

# Mistral moderation takes the risk half of the screen when set. Free tier.
MISTRAL_API_KEY=

# anthropic | openrouter | openrouter-eu
BOOKLY_PROVIDER=anthropic

# Optional: override the model for either tier, e.g. to run the suite on a
# different vendor through OpenRouter.
# BOOKLY_LIGHT_MODEL=deepseek/deepseek-v4.1-flash
# BOOKLY_HEAVY_MODEL=deepseek/deepseek-v4.1-flash

# Optional: where local runs write their logs. Useful when the UI and the
# evals run at the same time, so your own conversations stay out of samples/.
# BOOKLY_TRACE_LOG=local/trace.jsonl
# BOOKLY_ABUSE_LOG=local/abuse_log.jsonl
# BOOKLY_SAFETY_LOG=local/safety_log.jsonl
