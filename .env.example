# Copy to .env and fill in. providers.py loads it at import; .env is gitignored.

# Direct Anthropic API (the default provider).
ANTHROPIC_API_KEY=

# OpenRouter, used when BOOKLY_PROVIDER is openrouter or openrouter-eu.
OPENROUTER_API_KEY=

# anthropic | openrouter | openrouter-eu
BOOKLY_PROVIDER=anthropic
